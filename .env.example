# Application Configuration
APP_NAME=AtlasEstate-3D
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=atlas_admin
POSTGRES_PASSWORD=atlas_secret_pw
POSTGRES_DB=atlasestate_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atlas_admin:atlas_secret_pw@localhost:5432/atlasestate_db

# Local SQLite Fallback with Spatial Extensions
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=data/atlasestate.db

# Geospatial Settings
DEFAULT_CITY=Marrakech
DEFAULT_LATITUDE=31.6295
DEFAULT_LONGITUDE=-7.9811
DEFAULT_ZOOM=13
MAPBOX_ACCESS_TOKEN=pk.public_demo_token

# ML Valuation
MODEL_PATH=models/valuation/valuation_model.joblib
ML_CONFIDENCE_INTERVAL=0.10
